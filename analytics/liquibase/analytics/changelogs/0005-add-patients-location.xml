<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:pro="http://www.liquibase.org/xml/ns/pro"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
						http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.1.xsd
						http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
	<!--
		Adds the location where the patient was registered (the location of their preferred identifier)
		so patients can be filtered per location like the other tables. addColumn appends, and the
		flattening INSERT maps columns by position, so these must stay the last two columns of
		dsl/flattening/queries/patients.sql, in this order.
	-->
	<changeSet author="kipchubett" id="1791360000000">
		<preConditions onFail="MARK_RAN">
			<not>
				<columnExists tableName="patients" columnName="location_uuid" />
			</not>
		</preConditions>
		<addColumn tableName="patients">
			<column name="location" type="VARCHAR" />
			<column name="location_uuid" type="VARCHAR" />
		</addColumn>
		<createIndex tableName="patients" indexName="idx_patients_location_uuid">
			<column name="location_uuid" />
		</createIndex>
	</changeSet>
</databaseChangeLog>
